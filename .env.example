# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/fia?schema=public"

# 32+ char random secret used to sign session JWTs
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Public base URL of the deployment
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed control — set to "false" in production release step to skip re-seeding
SEED_DATABASE="true"
