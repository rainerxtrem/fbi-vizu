// Federal Investigative Agency (FIA) — data model
// GTA RP federal investigations portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Rank {
  NAT // New Agent Trainee
  SA // Special Agent
  SSA_SENIOR // Senior Special Agent
  SSA // Supervisory Special Agent
  ASAC // Assistant Special Agent in Charge
  SAC // Special Agent in Charge
  AD // Assistant Director
  AEAD // Associate Executive Assistant Director
  EAD // Executive Assistant Director
  ADD // Associate Deputy Director
  DD // Deputy Director
  DIRECTOR
}

enum AgentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum InvestigationStatus {
  OPEN
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Classification {
  UNCLASSIFIED
  RESTRICTED
  CONFIDENTIAL
  SECRET
}

enum PersonRole {
  SUSPECT
  VICTIM
  WITNESS
  ASSOCIATE
  PERSON_OF_INTEREST
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum EvidenceType {
  PHYSICAL
  DIGITAL
  DOCUMENT
  PHOTO
  VIDEO
  AUDIO
  FIREARM
  NARCOTIC
  FINANCIAL
  BIOLOGICAL
  OTHER
}

enum MostWantedStatus {
  DRAFT
  REVIEW
  PUBLISHED
  CAPTURED
  LOCATED
  ARCHIVED
}

enum DangerLevel {
  LOW
  MODERATE
  HIGH
  EXTREME
}

enum MostWantedCategory {
  MOST_WANTED
  FUGITIVE
  ORGANIZED_CRIME
  VIOLENT_CRIME
  TERRORISM
  CYBER_CRIME
  DRUG_TRAFFICKING
  WEAPONS
  FINANCIAL_CRIME
  MISSING_PERSON
  SEEKING_INFORMATION
}

enum TipStatus {
  NEW
  REVIEWING
  ASSIGNED
  ACTIONED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  BACKGROUND_CHECK
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationPosition {
  SPECIAL_AGENT
  INTELLIGENCE_ANALYST
  CRIME_ANALYST
  TACTICAL_AGENT
  CYBERCRIME_SPECIALIST
  FORENSIC_SPECIALIST
  ADMINISTRATIVE_STAFF
}

enum NewsCategory {
  PRESS_RELEASE
  CASE_UPDATE
  PUBLIC_NOTICE
  AGENCY_NEWS
  RECRUITMENT
  COMMUNITY
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WarrantType {
  ARREST
  SEARCH
  SURVEILLANCE
  SEIZURE
}

enum WarrantStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXECUTED
  EXPIRED
  DENIED
}

enum TimelineEventType {
  INVESTIGATION_OPENED
  INVESTIGATION_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  EVIDENCE_ADDED
  DOCUMENT_ADDED
  PERSON_LINKED
  WARRANT_REQUESTED
  WARRANT_APPROVED
  ARREST_MADE
  AGENT_ASSIGNED
  MOST_WANTED_CREATED
  CUSTOM
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  // Bumped whenever every existing session for this user must be invalidated
  // (password change, agent suspension, explicit "sign out everywhere").
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent Agent?

  auditLogs AuditLog[] @relation("AuditActor")
}

model FieldOffice {
  id      String  @id @default(cuid())
  name    String  @unique
  code    String  @unique
  city    String
  address String
  phone   String
  email   String
  isHq    Boolean @default(false)

  agents         Agent[]
  investigations Investigation[]
}

model Agent {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber  String      @unique
  rank         Rank        @default(NAT)
  title        String
  division     String
  unit         String?
  status       AgentStatus @default(ACTIVE)
  phone        String?
  hireDate     DateTime    @default(now())
  fieldOfficeId String?
  fieldOffice  FieldOffice? @relation(fields: [fieldOfficeId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // permission overrides managed by platform Admin
  permissionGrants  String[] @default([])
  permissionRevokes String[] @default([])

  // Set when this agent was onboarded from a recruitment application.
  applicationId String?      @unique
  application   Application? @relation("ApplicationHire", fields: [applicationId], references: [id])

  notifications Notification[]

  ledInvestigations      Investigation[]      @relation("LeadAgent")
  assignments            InvestigationAgent[]
  collectedEvidence      Evidence[]           @relation("EvidenceCollector")
  uploadedDocuments      Document[]           @relation("DocumentUploader")
  authoredNotes          InvestigationNote[]
  timelineEvents         TimelineEvent[]
  createdPersons         Person[]             @relation("PersonCreator")
  createdMostWanted      MostWanted[]         @relation("MostWantedCreator")
  reviewedMostWanted     MostWanted[]         @relation("MostWantedReviewer")
  assignedTips           Tip[]
  recruitingApplications Application[]        @relation("ApplicationRecruiter")
  decidedApplications    Application[]        @relation("ApplicationDecider")
  authoredNews           News[]
  requestedWarrants      Warrant[]            @relation("WarrantRequester")
  approvedWarrants       Warrant[]            @relation("WarrantApprover")
  arrests                Arrest[]             @relation("ArrestingAgent")
  rankChanges            RankChange[]         @relation("RankChangeTarget")
  authoredRankChanges    RankChange[]         @relation("RankChangeAuthor")
  uploadedFiles          FileAsset[]
}

model RankChange {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation("RankChangeTarget", fields: [agentId], references: [id], onDelete: Cascade)
  oldRank     Rank
  newRank     Rank
  changedById String?
  changedBy   Agent?   @relation("RankChangeAuthor", fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// INVESTIGATIONS
// ---------------------------------------------------------------------------

model Investigation {
  id             String              @id @default(cuid())
  caseNumber     String              @unique
  title          String
  description    String
  status         InvestigationStatus @default(OPEN)
  priority       Priority            @default(MEDIUM)
  classification Classification      @default(UNCLASSIFIED)

  leadAgentId String?
  leadAgent   Agent?  @relation("LeadAgent", fields: [leadAgentId], references: [id])

  fieldOfficeId String?
  fieldOffice   FieldOffice? @relation(fields: [fieldOfficeId], references: [id])
  division      String?
  unit          String?
  taskForce     String?

  incidentDate     DateTime?
  incidentLocation String?
  jurisdiction     String?

  isPublic  Boolean  @default(false)
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete — hidden everywhere but restorable from the trash.
  deletedAt   DateTime?
  deletedById String?

  assignedAgents InvestigationAgent[]
  persons        InvestigationPerson[]
  charges        InvestigationCharge[]
  evidence       Evidence[]
  documents      Document[]
  notes          InvestigationNote[]
  timeline       TimelineEvent[]
  vehicles       InvestigationVehicle[]
  organizations  InvestigationOrganization[]
  locations      InvestigationLocation[]
  warrants       Warrant[]
  arrests        Arrest[]
  mostWanted     MostWanted[]
  tips           Tip[]
  news           News[]
  relatedFrom    RelatedCase[]               @relation("RelatedFrom")
  relatedTo      RelatedCase[]               @relation("RelatedTo")
}

model RelatedCase {
  id          String   @id @default(cuid())
  fromId      String
  from        Investigation @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          Investigation @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([fromId, toId])
}

model InvestigationAgent {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role            String        @default("Assigned Agent")
  assignedAt      DateTime      @default(now())

  @@unique([investigationId, agentId])
}

model InvestigationNote {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  authorId        String?
  author          Agent?        @relation(fields: [authorId], references: [id])
  body            String
  createdAt       DateTime      @default(now())
}

model TimelineEvent {
  id              String            @id @default(cuid())
  investigationId String
  investigation   Investigation     @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  type            TimelineEventType  @default(CUSTOM)
  message         String
  actorAgentId    String?
  actorAgent      Agent?            @relation(fields: [actorAgentId], references: [id])
  occurredAt      DateTime          @default(now())
  meta            Json?
}

// ---------------------------------------------------------------------------
// PEOPLE, VEHICLES, ORGANIZATIONS
// ---------------------------------------------------------------------------

model Person {
  id             String     @id @default(cuid())
  fullName       String
  alias          String?
  dob            DateTime?
  gender         String?
  photoUrl       String?
  description    String?
  knownAddresses String?
  riskLevel      RiskLevel  @default(LOW)
  criminalHistory String?
  notes          String?
  createdById    String?
  createdBy      Agent?     @relation("PersonCreator", fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Soft delete — hidden everywhere but restorable from the trash.
  deletedAt   DateTime?
  deletedById String?

  investigations InvestigationPerson[]
  vehicles       PersonVehicle[]
  organizations  PersonOrganization[]
  evidence       Evidence[]
  charges        InvestigationCharge[]
  warrants       Warrant[]
  arrests        Arrest[]
  mostWanted     MostWanted[]
}

model InvestigationPerson {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  personId        String
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  role            PersonRole    @default(SUSPECT)
  notes           String?

  @@unique([investigationId, personId, role])
}

model Vehicle {
  id       String  @id @default(cuid())
  plate    String?
  make     String?
  model    String?
  color    String?
  year     Int?
  vin      String?
  notes    String?
  createdAt DateTime @default(now())

  persons        PersonVehicle[]
  investigations InvestigationVehicle[]
}

model PersonVehicle {
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([personId, vehicleId])
}

model Organization {
  id          String  @id @default(cuid())
  name        String  @unique
  type        String?
  description String?
  notes       String?
  createdAt   DateTime @default(now())

  persons        PersonOrganization[]
  investigations InvestigationOrganization[]
}

model PersonOrganization {
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String?

  @@id([personId, organizationId])
}

model InvestigationVehicle {
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([investigationId, vehicleId])
}

model InvestigationOrganization {
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([investigationId, organizationId])
}

model InvestigationLocation {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  label           String
  address         String?
  lat             Float?
  lng             Float?
  notes           String?
}

// ---------------------------------------------------------------------------
// CHARGES
// ---------------------------------------------------------------------------

model Charge {
  id       String  @id @default(cuid())
  code     String  @unique
  title    String
  category String
  severity String  @default("Felony")

  investigations InvestigationCharge[]
  arrests        ArrestCharge[]
}

model InvestigationCharge {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  chargeId        String
  charge          Charge        @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  personId        String?
  person          Person?       @relation(fields: [personId], references: [id])
  notes           String?

  @@unique([investigationId, chargeId, personId])
}

// ---------------------------------------------------------------------------
// EVIDENCE, DOCUMENTS, FILES
// ---------------------------------------------------------------------------

model FileAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  description  String?
  uploadedById String?
  uploadedBy   Agent?   @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  evidence  Evidence[]
  documents Document[]
  tips      Tip[]
}

model Evidence {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidenceNumber  String        @unique
  type            EvidenceType  @default(PHYSICAL)
  title           String
  description     String?
  chainOfCustody  String?
  personId        String?
  person          Person?       @relation(fields: [personId], references: [id])
  fileId          String?
  file            FileAsset?    @relation(fields: [fileId], references: [id])
  collectedById   String?
  collectedBy     Agent?        @relation("EvidenceCollector", fields: [collectedById], references: [id])
  collectedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  // Soft delete — hidden everywhere but restorable from the trash.
  deletedAt   DateTime?
  deletedById String?
}

model Document {
  id              String         @id @default(cuid())
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String         @default("General")
  fileId          String?
  file            FileAsset?     @relation(fields: [fileId], references: [id])
  uploadedById    String?
  uploadedBy      Agent?         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// WARRANTS & ARRESTS
// ---------------------------------------------------------------------------

model Warrant {
  id              String        @id @default(cuid())
  warrantNumber   String        @unique
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  personId        String?
  person          Person?       @relation(fields: [personId], references: [id])
  type            WarrantType   @default(ARREST)
  status          WarrantStatus @default(REQUESTED)
  description     String?
  issuingJudge    String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  // Public "wanted notice" — a redacted summary shown on FBI.gov when true.
  isPublic        Boolean       @default(false)
  publicSummary   String?
  deniedReason    String?
  requestedById   String?
  requestedBy     Agent?        @relation("WarrantRequester", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      Agent?        @relation("WarrantApprover", fields: [approvedById], references: [id])
  createdAt       DateTime      @default(now())
}

model Arrest {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  personId        String
  person          Person        @relation(fields: [personId], references: [id])
  arrestDate      DateTime      @default(now())
  location        String?
  charges         String?       // free-text notes; structured charges live in chargeLinks
  notes           String?
  arrestingAgentId String?
  arrestingAgent  Agent?        @relation("ArrestingAgent", fields: [arrestingAgentId], references: [id])
  createdAt       DateTime      @default(now())

  chargeLinks     ArrestCharge[]
}

model ArrestCharge {
  id       String @id @default(cuid())
  arrestId String
  arrest   Arrest @relation(fields: [arrestId], references: [id], onDelete: Cascade)
  chargeId String
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([arrestId, chargeId])
}

// ---------------------------------------------------------------------------
// MOST WANTED (public-facing)
// ---------------------------------------------------------------------------

model MostWanted {
  id                 String             @id @default(cuid())
  publicId           String             @unique // e.g. MW-0042
  status             MostWantedStatus   @default(DRAFT)
  category           MostWantedCategory @default(MOST_WANTED)
  dangerLevel        DangerLevel        @default(MODERATE)

  fullName           String
  aliases            String?
  age                Int?
  photoUrl           String?
  description        String
  charges            String[]           @default([])
  reward             Int                @default(0)
  lastKnownLocation  String?
  vehicle            String?
  associates         String?
  knownOrganizations String?
  dateLastSeen       DateTime?

  caseNumber         String?
  leadAgency         String             @default("Federal Investigative Agency")
  leadAgent          String?
  openedDate         DateTime?

  personId           String?
  person             Person?            @relation(fields: [personId], references: [id])
  investigationId    String?
  investigation      Investigation?     @relation(fields: [investigationId], references: [id])

  createdById        String?
  createdBy          Agent?             @relation("MostWantedCreator", fields: [createdById], references: [id])
  reviewedById       String?
  reviewedBy         Agent?             @relation("MostWantedReviewer", fields: [reviewedById], references: [id])

  publishedAt        DateTime?
  capturedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tips               Tip[]
  news               News[]
}

// ---------------------------------------------------------------------------
// TIPS (public submissions)
// ---------------------------------------------------------------------------

model Tip {
  id              String        @id @default(cuid())
  publicId        String        @unique // TIP-2026-000184
  subject         String
  description     String
  location        String?
  incidentDate    DateTime?
  anonymous       Boolean       @default(false)
  name            String?
  email           String?
  phone           String?
  status          TipStatus     @default(NEW)

  mostWantedId    String?
  mostWanted      MostWanted?   @relation(fields: [mostWantedId], references: [id])
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id])
  assignedToId    String?
  assignedTo      Agent?        @relation(fields: [assignedToId], references: [id])
  fileId          String?
  file            FileAsset?    @relation(fields: [fileId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// APPLICATIONS (public recruitment)
// ---------------------------------------------------------------------------

model Application {
  id        String              @id @default(cuid())
  publicId  String              @unique // APP-0044

  firstName String
  lastName  String
  dob       DateTime?
  phone     String
  email     String
  address   String?
  city      String?
  state     String?
  zip       String?

  currentOccupation    String?
  priorLeExperience    String?
  militaryExperience   String?
  education            String?
  certifications       String?

  position  ApplicationPosition @default(SPECIAL_AGENT)

  whyJoin            String?
  whyGoodCandidate   String?
  difficultDecision  String?
  pressureExperience String?

  resumeUrl     String?
  idUrl         String?
  certUrl       String?
  additionalUrl String?

  certified Boolean            @default(false)
  status    ApplicationStatus  @default(SUBMITTED)

  hiredAgent Agent? @relation("ApplicationHire")

  assignedRecruiterId String?
  assignedRecruiter   Agent?   @relation("ApplicationRecruiter", fields: [assignedRecruiterId], references: [id])
  notes               String?
  interviewNotes      String?
  backgroundCheckNotes String?
  decision            String?
  decidedById         String?
  decidedBy           Agent?   @relation("ApplicationDecider", fields: [decidedById], references: [id])

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// NEWS
// ---------------------------------------------------------------------------

model News {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  subtitle  String?
  imageUrl  String?
  category  NewsCategory @default(PRESS_RELEASE)
  status    NewsStatus   @default(DRAFT)
  content   String
  authorId  String?
  author    Agent?       @relation(fields: [authorId], references: [id])

  relatedInvestigationId String?
  relatedInvestigation   Investigation? @relation(fields: [relatedInvestigationId], references: [id])
  relatedMostWantedId    String?
  relatedMostWanted      MostWanted?    @relation(fields: [relatedMostWantedId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  actorLabel  String   @default("system")
  action      String
  entityType  String?
  entityId    String?
  summary     String
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ROLE ↔ PERMISSION OVERRIDES
//
// The code defines a baseline permission set per rank (RANK_ADDITIONS). Rows
// here let the Director tune that baseline per rank without a deploy:
//   granted = true  → permission added to the rank
//   granted = false → permission removed from the rank
// Absence of a row = use the code default.
// ---------------------------------------------------------------------------

model RolePermissionOverride {
  rank       Rank
  permission String
  granted    Boolean
  updatedById String?
  updatedAt  DateTime @updatedAt

  @@id([rank, permission])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS (per-agent, in-app)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String // e.g. CASE_ASSIGNED, WARRANT_APPROVED, WARRANT_DENIED, ARREST_MADE, RANK_CHANGED, TIP_ASSIGNED
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId, readAt])
  @@index([agentId, createdAt])
}
